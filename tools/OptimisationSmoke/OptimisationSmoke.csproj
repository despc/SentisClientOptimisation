    <Reference Include="Sandbox.Graphics"><HintPath>$(SeBin)\Sandbox.Graphics.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage"><HintPath>$(SeBin)\VRage.dll</HintPath><Private>False</Private></Reference>
