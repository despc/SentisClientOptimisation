    <Reference Include="VRage.Library"><HintPath>$(SeBin)\VRage.Library.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Math"><HintPath>$(SeBin)\VRage.Math.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Render"><HintPath>$(SeBin)\VRage.Render.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
</Project>
