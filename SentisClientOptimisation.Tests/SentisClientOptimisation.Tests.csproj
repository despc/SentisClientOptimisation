<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <!-- Keep stale framework binaries out of candidate references when tests redirect BaseOutputPath. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    <NoWarn>CS0618;NU1701;xUnit1026;xUnit1013</NoWarn>
    <SeBin Condition="'$(SeBin)' == ''">C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineers\Bin64</SeBin>
    <PulsarLib Condition="'$(PulsarLib)' == '' and '$(TargetFramework)' == 'net10.0'">$(APPDATA)\Pulsar\Libraries\Interim</PulsarLib>
    <PulsarLib Condition="'$(PulsarLib)' == ''">$(APPDATA)\Pulsar\Libraries\Legacy</PulsarLib>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SentisClientOptimisation\SentisClientOptimisation.csproj" />
    <!-- the game client's assemblies and Pulsar's Harmony, copied for the test run -->
    <Reference Include="0Harmony"><HintPath>$(PulsarLib)\0Harmony.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="Sandbox.Common"><HintPath>$(SeBin)\Sandbox.Common.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="Sandbox.Game"><HintPath>$(SeBin)\Sandbox.Game.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="Sandbox.Graphics"><HintPath>$(SeBin)\Sandbox.Graphics.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="SpaceEngineers.Game"><HintPath>$(SeBin)\SpaceEngineers.Game.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="SpaceEngineers.ObjectBuilders"><HintPath>$(SeBin)\SpaceEngineers.ObjectBuilders.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="VRage"><HintPath>$(SeBin)\VRage.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="VRage.Game"><HintPath>$(SeBin)\VRage.Game.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="VRage.Library"><HintPath>$(SeBin)\VRage.Library.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="VRage.Math"><HintPath>$(SeBin)\VRage.Math.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="VRage.Network"><HintPath>$(SeBin)\VRage.Network.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="VRage.Platform.Windows"><HintPath>$(SeBin)\VRage.Platform.Windows.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="VRage.Render"><HintPath>$(SeBin)\VRage.Render.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="HavokWrapper"><HintPath>$(SeBin)\HavokWrapper.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="ProtoBuf.Net"><HintPath>$(SeBin)\ProtoBuf.Net.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="ProtoBuf.Net.Core"><HintPath>$(SeBin)\ProtoBuf.Net.Core.dll</HintPath><Private>True</Private></Reference>
  </ItemGroup>

</Project>
